---
import Base from '../layouts/Base.astro';
import { experience, skills, education, certifications, languages } from '../data/profile';
import TechStack from '../components/TechStack.astro';
const methods = skills.filter((s) => ['Evaluation', 'Computer vision'].includes(s.group));
---
<Base title="About — Chi-Yi Hsu">
  <div class="intro">
    <img class="photo" src="/about-photo.jpg" width="640" height="800" alt="Chi-Yi (Amo) Hsu sitting in a mountain waterfall" />
    <div>
      <p class="eyebrow">about</p>
      <h1>Chi-Yi (Amo) Hsu</h1>
      <p class="lead">
        Amo is a Senior AI Engineer at Delta Electronics in Taoyuan, Taiwan, who designs, ships and operates production
        AI services for engineering and procurement teams across Europe and Asia.
      </p>
    </div>
  </div>

  <p>
    Amo is drawn to problems where AI has to be reliable rather than impressive: deciding where a rule is safer than
    a model, where a person must review a case, and how to measure whether a change actually made things better.
    In practice that means business rules kept in code instead of prompts, labelled evaluation sets before every
    release, a fallback path for when the model is down, and read-only access wherever a bug could damage production data.
  </p>
  <p>
    Amo owns the whole path, not just the model: setting up the team’s MLflow and MinIO servers, serving fine-tuned
    models on-prem with vLLM, and shipping services through GitLab CI to air-gapped production. Working with colleagues
    in Germany and Asia, Amo bridges business stakeholders and engineering — mapping workflows with the people who run
    them, deciding when the AI should hand a case to a person, and turning an all-at-once request into a phased plan,
    such as the six-month, three-phase QA sign-off project whose first phase shipped on time and is in production.
  </p>
  <p>
    Before Delta, Amo worked at Mirle Automation on OCR and computer-vision applications, and holds an M.S. in
    Computer and Communication Engineering from National Kaohsiung University of Science and Technology.
  </p>

  <h2>Experience</h2>
  <ol class="timeline">
    {experience.map((e) => (
      <li>
        <span class="node"></span>
        <div class="tl-head"><strong>{e.role}</strong> · {e.org}</div>
        <div class="meta mono">{e.period} · {e.place}</div>
        <p>{e.text}</p>
      </li>
    ))}
  </ol>
  <p><a href="/projects/">See the projects behind this →</a></p>

  <h2>Tech stack</h2>
  <p class="eyebrow">tools</p>
  <TechStack />

  <h2>Methods</h2>
  <p class="eyebrow">how Amo makes AI reliable</p>
  <div class="cards skills">
    {methods.map((s) => (
      <div class="card">
        <h3 class="mono">{s.group}</h3>
        <div class="tags">{s.items.map((i) => <span>{i}</span>)}</div>
      </div>
    ))}
  </div>

  <h2>Education & certifications</h2>
  <div class="cards">
    {education.map((e) => (
      <div class="card"><h3>{e.degree}</h3><p>{e.school}</p><p class="mono meta">{e.period}</p></div>
    ))}
    <div class="card">
      <h3>Certifications</h3>
      {certifications.map((c) => <p>{c}</p>)}
      <h3 style="margin-top:12px">Languages</h3>
      <p>{languages.join(' · ')}</p>
    </div>
  </div>

  <h2>Contact</h2>
  <p>The quickest way to reach Amo is on <a href="https://linkedin.com/in/chi-yi-hsu">LinkedIn</a>.
     Code lives on <a href="https://github.com/steven91007">GitHub</a>.</p>
</Base>

<style>
  .intro { display: grid; grid-template-columns: 240px 1fr; gap: 36px; align-items: center; }
  .photo { width: 240px; height: auto; aspect-ratio: 4 / 5; object-fit: cover; border-radius: 18px; padding: 3px;
           background: linear-gradient(140deg, var(--accent), var(--accent-2) 55%, var(--ok));
           box-shadow: 0 20px 60px -18px rgba(56,189,248,.55); }
  .timeline { list-style: none; padding: 0 0 0 22px; margin: 18px 0 0; border-left: 1px solid rgba(56,189,248,.3); }
  .timeline li { position: relative; padding: 0 0 22px 8px; }
  .timeline .node { position: absolute; left: -29px; top: 7px; width: 13px; height: 13px; border-radius: 50%;
                    background: var(--bg); border: 2px solid var(--accent); box-shadow: 0 0 12px rgba(56,189,248,.6); }
  .timeline p { margin: 6px 0 0; color: #c3cfdd; }
  .meta { font-size: .76rem; color: var(--muted); }
  .skills h3 { font-size: .9rem; color: var(--accent); }
  @media (max-width: 600px) {
    .intro { grid-template-columns: 1fr; gap: 18px; }
    .photo { width: min(260px, 70vw); }
  }
</style>
