---
interface Props { title: string; description?: string; wide?: boolean }
const { title, wide = false, description = 'Chi-Yi (Amo) Hsu — AI engineer building production LLM agents, evaluation and MLOps.' } = Astro.props;
const nav = [
  { href: '/', label: 'Home' },
  { href: '/projects/', label: 'Projects' },
  { href: '/about/', label: 'About' },
];
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <header class="wrap">
      <a class="brand" href="/">Chi-Yi Hsu</a>
      <nav>
        {nav.map((n) => <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>)}
      </nav>
    </header>
    <main class:list={["wrap", { wide }]}><slot /></main>
    <footer class="wrap">
      <a href="https://github.com/steven91007">GitHub</a> ·
      <a href="https://linkedin.com/in/chi-yi-hsu">LinkedIn</a> ·
      <a href="/impressum/">Impressum</a>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #ffffff; --fg: #1f2933; --muted: #5f6b7a; --accent: #1d5fa8; --line: #e3e8ee; --card: #f7f9fb;
    color-scheme: light dark;
  }
  @media (prefers-color-scheme: dark) {
    :root { --bg: #0f141a; --fg: #e6ebf0; --muted: #9aa7b4; --accent: #6fb0f0; --line: #26313c; --card: #161d25; }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--fg);
         font: 17px/1.6 system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; }
  .wrap { max-width: 760px; margin: 0 auto; padding: 0 16px; }
  .wrap.wide { max-width: 1180px; }
  header { display: flex; justify-content: space-between; align-items: center; padding-top: 24px; padding-bottom: 24px; gap: 16px; flex-wrap: wrap; }
  .brand { font-weight: 700; color: var(--fg); text-decoration: none; }
  nav { display: flex; gap: 18px; }
  nav a { color: var(--muted); text-decoration: none; }
  nav a[aria-current='page'], nav a:hover { color: var(--accent); }
  a { color: var(--accent); }
  h1 { font-size: 2rem; line-height: 1.2; margin: 8px 0 12px; }
  h2 { font-size: 1.25rem; margin-top: 40px; }
  .muted { color: var(--muted); }
  .cards { display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); margin-top: 16px; }
  .card { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 16px 18px; }
  .card h3 { margin: 0 0 6px; font-size: 1.05rem; }
  .card p { margin: 0; color: var(--muted); font-size: 0.95rem; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
  .tags span { font-size: 0.8rem; border: 1px solid var(--line); border-radius: 999px; padding: 1px 9px; color: var(--muted); }
  footer { border-top: 1px solid var(--line); margin-top: 64px; padding-top: 20px; padding-bottom: 40px; color: var(--muted); font-size: 0.9rem; }
  footer a { color: var(--muted); }
</style>
